# ─── Supabase (públicas — vão para o browser) ────────────────────────────────
# Onde encontrar: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# ─── URL do site (usada nos e-mails de recuperação de senha) ─────────────────
# Em produção: https://seu-dominio.com | Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NUNCA coloque a service_role key em variáveis NEXT_PUBLIC_*.
# Este projeto não usa service_role no app — todo acesso passa por RLS.

# ─── Cobrança automática (Mercado Pago) — OPCIONAL, só na Vercel ─────────────
# Painel MP → Suas integrações → credenciais de PRODUÇÃO → Access Token
# NUNCA use prefixo NEXT_PUBLIC nestas duas — são segredos de servidor.
MERCADOPAGO_ACCESS_TOKEN=

# Supabase → Project Settings → API Keys → service_role (apenas p/ o webhook)
SUPABASE_SERVICE_ROLE_KEY=
